# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cuet
REDIS_URL=redis://localhost:6379

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Authentication
NEXTAUTH_API_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-min-32-characters
NEXTAUTH_URL=http://localhost:3000

# OAuth (if implementing social auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API Keys
OPENAI_API_KEY=  # For AI Tutor features
GEMINI_API_KEY=  # For AI analysis

# Email Service (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cuetplatform.com

# AWS (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=cuet-platform
AWS_REGION=us-east-1

# Analytics
GOOGLE_ANALYTICS_ID=
POSTHOG_API_KEY=

# Feature Flags
ENABLE_GAMIFICATION=true
ENABLE_AI_TUTOR=true
ENABLE_ADMIN_PANEL=true
MAX_FILE_UPLOAD_SIZE=52428800  # 50MB in bytes

# Logging
LOG_LEVEL=info
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000  # 15 minutes

